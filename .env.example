# Config dos scripts de RPA (worker.ps1 e submit.ps1).
# Copie para ".env" e preencha. NAO comite o .env real (ver .gitignore).
# Os segredos do Cloudflare Worker continuam no painel dele; isto e so pros scripts.

BASE_URL=https://senior.lucas-ramos-086.workers.dev
WORKER_TOKEN=coloque_o_worker_token_aqui
CLIENT_TOKEN=coloque_o_client_token_aqui
POLL_SECONDS=5

# SCRIPT e LOG_JSONL: deixe EM BRANCO para usar os arquivos ao lado do worker.ps1
# (funciona em qualquer maquina). Se preencher, pode ser relativo (ao worker.ps1)
# ou caminho absoluto. Ex.: SCRIPT=encerra_mdfe.ps1
SCRIPT=
LOG_JSONL=
